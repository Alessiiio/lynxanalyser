# Required for Google Safe Browsing check (15 pts)
# Free at: https://console.cloud.google.com -> APIs & Services -> Safe Browsing API
GOOGLE_SAFEBROWSING_API_KEY=

# Required for VirusTotal check (10 pts)
# Free at: https://www.virustotal.com/gui/sign-in -> API Key
VIRUSTOTAL_API_KEY=

# Google Places API (New) for Google Business reviews check (12 pts, Tier 2)
# Enable "Places API (New)" at: https://console.cloud.google.com/google/maps-apis/
GOOGLE_PLACES_API_KEY=

# Required for URLScan.io check (5 pts) — now requires API key for submission
# Free at: https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Required for Zefix Swiss company lookup (15 pts) — primary firm API
# Register a free account at: https://www.zefix.admin.ch/ZefixREST/
ZEFIX_USERNAME=
ZEFIX_PASSWORD=

# Optional: Person→mandate fill-in via Moneyhouse (watchlist + firm network SW3+).
# Zefix/SHAB remain primary; firm identity is always resolved via Zefix.
# Default is on when unset. Set to 0 to disable.
# MONEYHOUSE_PERSON_SEARCH=1

# IOSCO I-SCAN international regulator warnings (10 pts, Tier 1)
# Request API key: api@iosco.org — docs: https://api.iosco.org/v1/i-scan/
IOSCO_ISCAN_API_KEY=

# AI Fraud Analysis — set ONE of the two options below (15 pts)
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:12b

# ── Production / Docker ──────────────────────────────────────
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
# Public hostname (Caddy + TrustedHost). Example: lynx.example.com
DOMAIN=example.com
# Comma-separated hosts; defaults to DOMAIN,localhost,127.0.0.1 when DOMAIN is set
# ALLOWED_HOSTS=example.com,localhost,127.0.0.1
# IPs allowed to set X-Forwarded-* (use * only when the app port is not public)
# FORWARDED_ALLOW_IPS=127.0.0.1
# 1 when TLS terminates in front of the app (Caddy / nginx / Cloudflare)
# Secure session cookies — only applied when DOMAIN is also set (local HTTP stays without Secure)
HTTPS_ONLY=1

# Long random string — required in production
SESSION_SECRET=

# Fernet key for encrypting TOTP secrets at rest (separate from SESSION_SECRET).
# Required in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In local development, if unset, a key is derived from SESSION_SECRET (warning in logs).
TOTP_ENCRYPTION_KEY=

# Bootstrap accounts (min. 12 chars, not trivial). Applied when DB has no users,
# or when FORCE_RESET_SEED_PASSWORDS=1 (set back to 0 after first boot).
SEED_ADMIN_PASSWORD=
SEED_CASE_MANAGER_PASSWORD=
# Legacy alias (still read if SEED_CASE_MANAGER_PASSWORD empty):
# SEED_ANALYST_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
# Personal admin (optional): creates/updates user "alessio" as Admin
SEED_ALESSIO_PASSWORD=
FORCE_RESET_SEED_PASSWORDS=0

RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=8
# LOGIN_2FA_RATE_LIMIT_PER_MINUTE=10
# CACHE_TTL_SECONDS=300
# DATABASE_PATH=./fraud_checks.db

# ── Watchlist E-Mail-Benachrichtigung (optional) ─────────────
# Bei neuen Mandaten / Firmenverknüpfungen (täglicher Cron 04:15 + manueller Scan).
# Ohne diese Werte: Monitoring läuft weiter, aber kein E-Mail-Versand.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=lynx@example.com
# SMTP_USE_TLS=1
# Comma-separated team inboxes (User-Accounts haben kein E-Mail-Feld)
# WATCHLIST_NOTIFY_EMAILS=fraud-team@example.com,compliance@example.com

# ── Watchlist Rolling-Scan (API-schonend) ────────────────────
# Nacht-Cron 04:15: zuerst ALLE high-prio (Cap), dann Rolling-Rest.
# Siehe docs/WATCHLIST_SCAN_SCALING.md + docs/WATCHLIST_FRAUD_FOLLOWUP.md
# WATCHLIST_SCAN_BATCH=25
# Pause zwischen Personen in Sekunden (0 = aus); leichtes Jitter wird addiert
# WATCHLIST_SCAN_DELAY_SEC=2
# UI-Button «Liste fortsetzen»
# WATCHLIST_SCAN_MANUAL_LIMIT=5
# High-Prio (Fall / In Abklärung): max. Personen jede Nacht
# WATCHLIST_SCAN_HIGH_PRIORITY_CAP=50

# ── SHAB-Tagesarchiv (CH-weit, komplementär zu Moneyhouse) ───
# Cron 05:45: gestern–heute via ZefixREST /shab/search → SQLite (fraud_checks.db).
# Siehe docs/SHAB_DAILY_WATCHLIST.md. Default aus — in Prod auf 1 setzen.
# SHAB_DAILY_INGEST=1
# Watchlist-Match nach Ingest (NetworkAlert Quelle shab_daily); 0 = nur speichern
# SHAB_DAILY_MATCH=1
# Retention: 0 = unbegrenzt (MVP); Phase-3 Job später (≥90 Tage empfohlen)
# SHAB_DAILY_RETENTION_DAYS=0
